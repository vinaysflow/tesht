# Database
DATABASE_URL=postgresql://tesht:tesht_dev_password@localhost:5432/tesht
POSTGRES_USER=tesht
POSTGRES_PASSWORD=tesht_dev_password
POSTGRES_DB=tesht

# API Configuration
API_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
API_HOST=0.0.0.0
API_PORT=8000

# Domain (for did:web)
TESHT_DOMAIN=localhost%3A5000
TESHT_SCHEME=http

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_DOMAIN=localhost:6080

# Security
ALLOWED_ORIGINS=http://127.0.0.1:6080,http://localhost:6080,http://127.0.0.1:5000,http://localhost:5000
CORS_ENABLED=true

# Development
DEBUG=true
LOG_LEVEL=INFO
