# Copy this to .env.production and fill in your deployed service URLs.
# These are injected at build time by Vite (VITE_ prefix required).
#
# Deploy backend services to Railway, Render, or any VPS, then paste URLs here.
# Add the same variables in Vercel Dashboard → Project → Settings → Environment Variables.

VITE_GATEWAY_URL=https://your-tesht-gateway.railway.app
VITE_IDP_BRIDGE_URL=https://your-tesht-bridge.railway.app
VITE_MOCK_OIDC_URL=https://your-tesht-oidc.railway.app
VITE_MOCK_MCP_URL=https://your-tesht-mcp.railway.app
VITE_SQLITE_MCP_URL=https://your-tesht-sqlite.railway.app
